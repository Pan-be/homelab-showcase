[Unit]
Description=Spotify Soloist (Spotify Connect receiver "Serverus")
Wants=network-online.target pulseaudio.service
After=network-online.target pulseaudio.service

[Service]
EnvironmentFile=%h/.config/soloist/soloist.env
Environment=PULSE_SINK=alsa_output.pci-0000_00_1f.3.analog-stereo
ExecStartPre=-/usr/bin/pactl set-card-profile alsa_card.pci-0000_00_1f.3 output:analog-stereo
# PulseAudio picks the (empty) front headphone port, which mutes the rear jack
ExecStartPre=-/usr/bin/pactl set-sink-port alsa_output.pci-0000_00_1f.3.analog-stereo analog-output-lineout
ExecStartPre=-/usr/bin/pactl set-sink-volume alsa_output.pci-0000_00_1f.3.analog-stereo 115%
ExecStart=%h/.local/bin/soloist --device-name Serverus --api-key ${SOLOIST_API_KEY} --data-dir %h/.local/share/soloist
Restart=on-failure
RestartSec=10
# exit 10 = build expired: soloist-update fixes it, restarting won't
RestartPreventExitStatus=10

[Install]
WantedBy=default.target
